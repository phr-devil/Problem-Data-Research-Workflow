{
  "protocol_version": "pd-rw-human-review-v1.3",
  "owner": "WORKFLOW.md",
  "new_project_mode": "USER_DEEP_PARTICIPATION",
  "new_project_sequence": [
    "H1",
    "H2",
    "H3",
    "H4",
    "H5"
  ],
  "notes": [
    "Stable REVIEW:H1..H10 identifiers are scientific decisions, not HEADING:H1..H3 manuscript headings.",
    "H1–H6, strategic H8, and H9/H10 require original-user choice or explicit scoped delegation where applicable. H7 and routine in-scope DEV technology remain agent-owned; user choice of research strategy is not per-run execution permission. Declarations never authenticate actual permissions.",
    "Dimension evidence and original user messages must be checked externally; a structural PASS never authenticates user approval.",
    "Theory/simulation projects use PROOF_PATH in H4; H7 and H9 are conditional by scientific relevance, with reasons recorded.",
    "New dataset acquisition, project-level target changes/STOP, sealed/independent confirmation, actual financial charges, unsafe installations, external transfer, figures, manuscript writing and submission retain their separate gates. An explicit project-level prohibition overrides default DEV autonomy.",
    "H6 author chooses recommended research strategy and Task; H8 author chooses core scientific Claim and substantive science upgrade/reframe strategy. Technical H7, ordinary DEV experiments and within-delegation work remain autonomous. Old v1.2 H6/H8 agent decisions are not silently promoted to new author confirmations."
  ],
  "vocabularies": {
    "question_sources": [
      "DOMAIN_BOTTLENECK",
      "PAPER_CONTRADICTION",
      "FAILURE_BOUNDARY",
      "DATA_EVALUATION_DEFECT",
      "CROSS_DOMAIN_PRINCIPLE",
      "ANOMALY_NEGATIVE_RESULT"
    ],
    "contribution_routes": [
      "MAJOR_INNOVATION",
      "PERFORMANCE_BREAKTHROUGH",
      "SCIENTIFIC_DISCOVERY",
      "RESEARCH_INFRASTRUCTURE",
      "COGNITIVE_CORRECTION"
    ],
    "science_routes": [
      "R1",
      "R2",
      "R3",
      "R4",
      "R5",
      "R6"
    ],
    "contribution_types": [
      "C01",
      "C02",
      "C03",
      "C04",
      "C05",
      "C06",
      "C07",
      "C08",
      "C09",
      "C10",
      "C11",
      "C12"
    ],
    "author_strategy_choices": [
      "USER_CONFIRMED",
      "USER_DELEGATED",
      "PENDING"
    ]
  },
  "steps": {
    "H1": {
      "activity": "01",
      "name": "研究目标与范围",
      "prerequisites": [],
      "required_dimensions": [
        "discipline_scope",
        "research_goal",
        "resources_constraints",
        "risk_preference"
      ],
      "evidence_minimum": [
        "user_scope_and_exclusions"
      ],
      "reopen_when": "new scope or resource constraints",
      "decision_owner": "USER"
    },
    "H2": {
      "activity": "01",
      "name": "课题来源及论文贡献路线",
      "prerequisites": [
        "H1"
      ],
      "required_dimensions": [
        "question_sources",
        "contribution_routes",
        "search_focus"
      ],
      "evidence_minimum": [
        "source_route_tradeoffs",
        "contribution_route_tradeoffs"
      ],
      "reopen_when": "user changes exploration strategy or critical new evidence",
      "decision_owner": "USER"
    },
    "H3": {
      "activity": "01",
      "name": "候选科学问题选择",
      "prerequisites": [
        "H1",
        "H2"
      ],
      "required_dimensions": [
        "provisional_question",
        "alternative_or_justified_single",
        "nearest_work_and_falsifier"
      ],
      "evidence_minimum": [
        "breadth_deep_competing_search",
        "named_nearest_neighbor_or_unknown",
        "competing_risks"
      ],
      "reopen_when": "major nearest-neighbor gap or scientific question changed",
      "decision_owner": "USER"
    },
    "H4": {
      "activity": "01",
      "name": "主数据库或理论证据路径",
      "prerequisites": [
        "H3"
      ],
      "required_dimensions": [
        "dataset_or_proof_path",
        "truth_and_independence",
        "license_and_cost"
      ],
      "evidence_minimum": [
        "official_metadata_or_proof_requirements",
        "source_and_feasibility_comparison"
      ],
      "reopen_when": "data truth, grouping, access, or proof path invalidated",
      "decision_owner": "USER"
    },
    "H5": {
      "activity": "01",
      "name": "最终研究问题确认",
      "prerequisites": [
        "H3",
        "H4"
      ],
      "required_dimensions": [
        "final_question",
        "main_and_backup",
        "evidence_and_claim_boundary",
        "next_step_scope"
      ],
      "evidence_minimum": [
        "question_data_evidence_fit",
        "strongest_unknown_and_retreat"
      ],
      "reopen_when": "topic-data-evidence contract materially changes",
      "decision_owner": "USER"
    },
    "H6": {
      "activity": "03",
      "name": "作者研究策略与核心Task选择",
      "prerequisites": [
        "H5"
      ],
      "required_dimensions": [
        "selected_strategy_option",
        "primary_task_and_evaluation",
        "main_contribution_type_and_route",
        "scientific_value_and_efficiency_tradeoff",
        "dev_autonomy_envelope"
      ],
      "evidence_minimum": [
        "ranked_options_and_ai_recommendation",
        "named_nearest_neighbor_and_falsifier",
        "dev_or_theory_feasibility",
        "alternative_failure_premise_or_single_reason"
      ],
      "reopen_when": "material Task, legal information, core evaluation or selected research strategy changes beyond original author choice/delegation; ordinary algorithm/DEV changes do not reopen",
      "decision_owner": "USER",
      "decision_style": "AUTHOR_STRATEGY_SELECTION",
      "review_guidance_ref": "AUTHOR_STRATEGY_REVIEW.md"
    },
    "H7": {
      "activity": "04",
      "name": "主要算法机制与成本",
      "prerequisites": [
        "H6"
      ],
      "required_dimensions": [
        "mechanism_route",
        "simple_alternative",
        "experiment_budget"
      ],
      "evidence_minimum": [
        "failure_premise_or_mechanism_hypothesis",
        "fair_comparison_plan"
      ],
      "reopen_when": "technical mechanisms and local DEV experiments remain agent decisions within author-selected H6/H8 strategy and H5; changing strategic goals requires the appropriate author decision",
      "applicability": "conditional_algorithm_or_major_experimental_strategy",
      "decision_owner": "AGENT"
    },
    "H8": {
      "activity": "05",
      "name": "作者核心科学贡献与重大升级选择",
      "prerequisites": [
        "H6"
      ],
      "required_dimensions": [
        "selected_main_claim",
        "selected_contribution_route",
        "keep_upgrade_reframe_or_hold",
        "claim_boundary_and_confirmation_gap",
        "continuation_scope_and_cost"
      ],
      "evidence_minimum": [
        "actual_positive_and_negative_evidence",
        "named_nearest_neighbor_gap_and_strongest_objection",
        "ranked_claim_options_and_ai_recommendation",
        "publication_potential_or_explicit_unknown"
      ],
      "reopen_when": "material change of primary Claim, contribution route, large science upgrade, project strategy or prior evidence invalidation; ordinary in-scope experiments do not reopen",
      "decision_owner": "USER",
      "decision_style": "AUTHOR_CONTRIBUTION_SELECTION",
      "review_guidance_ref": "AUTHOR_STRATEGY_REVIEW.md"
    },
    "H9": {
      "activity": "06",
      "name": "独立确认方案",
      "prerequisites": [
        "H8"
      ],
      "required_dimensions": [
        "frozen_claim",
        "confirmation_resource",
        "protocol_and_permission"
      ],
      "evidence_minimum": [
        "independence_and_selection_history",
        "authorization_separate"
      ],
      "reopen_when": "confirmation protocol or access changes",
      "applicability": "conditional_formal_confirmation",
      "decision_owner": "USER"
    },
    "H10": {
      "activity": "06",
      "name": "科研总结审查与论文下一步",
      "prerequisites": [
        "H8"
      ],
      "required_dimensions": [
        "results_review",
        "limitations_and_confirmation_status",
        "next_paper_decision"
      ],
      "evidence_minimum": [
        "actual_claim_evidence",
        "writing_permission_separate"
      ],
      "reopen_when": "science summary or publication plan changes",
      "decision_owner": "USER"
    }
  },
  "legacy_protocol_versions": [
    "pd-rw-human-review-v1.1",
    "pd-rw-human-review-v1.2"
  ],
  "new_project_strategy_reviews": [
    "H6",
    "H8"
  ]
}
